+/* iOS Backup: optional payload-free activity records for the process supervisor.
+ * Only successful protocol reads/writes advance the counter. A timeout or a
+ * progress repaint is not activity. Called exclusively from the main thread. */
+static int iosbk_activity_enabled = 0;
+static uint64_t iosbk_activity_sequence = 0;
+static const char *iosbk_activity_phase = "preparing";
+static const char *iosbk_activity_emitted_phase = NULL;
+static time_t iosbk_activity_emitted_second = 0;
+
+static void iosbk_activity(const char *phase, uint32_t bytes, int force)
+{
+	if (!iosbk_activity_enabled) return;
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return;
+	iosbk_activity_sequence += bytes;
+	iosbk_activity_phase = phase;
+	int changed = !iosbk_activity_emitted_phase || strcmp(phase, iosbk_activity_emitted_phase);
+	if (force || changed || (bytes && ts.tv_sec != iosbk_activity_emitted_second)) {
+		fprintf(stderr, "IOSBK_ACTIVITY %llu %s\n", (unsigned long long)iosbk_activity_sequence, phase);
+		fflush(stderr);
+		iosbk_activity_emitted_second = ts.tv_sec;
+		iosbk_activity_emitted_phase = phase;
+	}
+}
+
+static mobilebackup2_error_t iosbk_send_raw(mobilebackup2_client_t client, const char *data, uint32_t length, uint32_t *sent)
+{
+	iosbk_activity("sending", 0, 0);
+	*sent = 0;
+	mobilebackup2_error_t result = mobilebackup2_send_raw(client, data, length, sent);
+	iosbk_activity("sending", *sent, 0);
+	return result;
+}
+
+static mobilebackup2_error_t iosbk_receive_raw(mobilebackup2_client_t client, char *data, uint32_t length, uint32_t *received)
+{
+	iosbk_activity("receiving", 0, 0);
+	*received = 0;
+	mobilebackup2_error_t result = mobilebackup2_receive_raw(client, data, length, received);
+	iosbk_activity("receiving", *received, 0);
+	return result;
+}
+
+static mobilebackup2_error_t iosbk_receive_message(mobilebackup2_client_t client, plist_t *message, char **identifier)
+{
+	/* A receive timeout while waiting for a passcode is still authorization. */
+	if (strcmp(iosbk_activity_phase, "waiting_authorization")) iosbk_activity("waiting_device", 0, 0);
+	mobilebackup2_error_t result = mobilebackup2_receive_message(client, message, identifier);
+	if (result == MOBILEBACKUP2_E_SUCCESS) iosbk_activity("waiting_device", 1, 0);
+	return result;
+}
 
